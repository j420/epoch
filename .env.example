# ---- Sarvam ----------------------------------------------------------------
# The only secret that matters. Never exposed to the browser: every call is
# proxied through a server route in app/api/.
SARVAM_API_KEY=
# Prompt 9: a second key and a one-line switch. Set SARVAM_USE_BACKUP=1 to flip.
SARVAM_API_KEY_BACKUP=
SARVAM_USE_BACKUP=0

# Optional model pins. Defaults are already correct; override only to test.
# SARVAM_BASE_URL=https://api.sarvam.ai
# SARVAM_STT_MODEL=saaras:v3
# SARVAM_TTS_MODEL=bulbul:v3
# SARVAM_CHAT_FAST=sarvam-30b
# SARVAM_CHAT_DEEP=sarvam-105b
# SARVAM_TRANSLATE_MODEL=sarvam-translate:v1
# SARVAM_TRANSLATE_COLLOQUIAL=mayura:v1
# Comma-separated candidates tried in order for document parse.
# SARVAM_VISION_PATHS=/parse/parsepdf,/v1/document/parse,/document-parse

# ---- Database --------------------------------------------------------------
# Leave blank to use the zero-config file-backed store in .data/ (fine for a sprint).
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Public bucket used for memory audio and report photos.
SUPABASE_STORAGE_BUCKET=bol

# ---- Razorpay --------------------------------------------------------------
# NOTE: Razorpay QR codes are scannable only in Live Mode.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# ---- Ops -------------------------------------------------------------------
# Single shared password for /admin memory moderation.
BOL_ADMIN_TOKEN=
# Public base URL, used for QR codes and postcard links.
NEXT_PUBLIC_BASE_URL=http://localhost:3000
