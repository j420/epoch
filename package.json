{
  "name": "bol",
  "version": "0.1.0",
  "private": true,
  "description": "Bol \u2014 scan and speak to an Indian monument in any of 22 languages. No app. No language picker.",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "smoke": "tsx scripts/smoke.ts",
    "seed": "tsx scripts/seed.ts",
    "verify:language": "tsx scripts/verify-language.ts",
    "verify:guardrails": "tsx scripts/verify-guardrails.ts",
    "verify": "npm run verify:language && npm run verify:guardrails"
  },
  "dependencies": {
    "@huggingface/transformers": "^3.3.1",
    "@supabase/supabase-js": "^2.45.4",
    "next": "14.2.15",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "three": "^0.169.0"
  },
  "devDependencies": {
    "@types/node": "^20.16.11",
    "@types/react": "^18.3.11",
    "@types/react-dom": "^18.3.0",
    "@types/three": "^0.169.0",
    "autoprefixer": "^10.4.20",
    "eslint": "^8.57.1",
    "eslint-config-next": "14.2.15",
    "postcss": "^8.4.47",
    "tailwindcss": "^3.4.13",
    "tsx": "^4.19.1",
    "typescript": "5.6.3"
  }
}
